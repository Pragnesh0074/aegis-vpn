# Production environment for the API, installed at /etc/aegis/api.env
#
#   sudo install -o root -g vpnapi -m 640 ops/api.env.example /etc/aegis/api.env
#   sudo nano /etc/aegis/api.env
#
# Mode 640 root:vpnapi — readable by the service, not world-readable. It holds the
# database password and both JWT secrets.

NODE_ENV=production
PORT=3000
CORS_ORIGINS=

# From the provision.sh summary output.
DATABASE_URL="postgresql://aegis:REPLACE_ME@localhost:5432/aegis?schema=public"

# Two DIFFERENT values: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

MAX_DEVICES_PER_USER=5

# Which `nodes` row is THIS host's own interface. Leave blank while the fleet has a
# single node; it becomes required the moment a second one is active, because the
# API can no longer infer which interface it owns and refuses to guess rather than
# write one country's peers onto another country's wg0.
#   psql> select id, name, region from nodes;
WG_NODE_ID=

# Real wg binary. env.validation.ts refuses to boot with 'fake' under
# NODE_ENV=production, because the API would confirm peers over HTTP while never
# touching wg0.
WG_RUNNER=exec
WG_INTERFACE=wg0
WG_BINARY=/usr/bin/wg
WG_QUICK_BINARY=/usr/bin/wg-quick
WG_RECONCILE_ON_BOOT=true

# Caddy sits in front, so X-Forwarded-For is trustworthy here.
TRUST_PROXY=true

# Seed values — SEED_NODE_PUBLIC_KEY comes from: cat /etc/wireguard/server.pub
SEED_NODE_NAME="Mumbai #1"
SEED_NODE_REGION=in-mumbai
SEED_NODE_PUBLIC_KEY=
SEED_NODE_ENDPOINT=vpn.example.com:51820
SEED_NODE_SUBNET_V4=10.7.0.0/24
SEED_NODE_DNS=10.7.0.1
SEED_NODE_MTU=1420
