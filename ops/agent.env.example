# Environment for the node-agent, installed at /etc/aegis/agent.env
#
#   sudo install -o root -g vpnapi -m 640 ops/agent.env.example /etc/aegis/agent.env
#   sudo nano /etc/aegis/agent.env
#
# Mode 640 root:vpnapi. The token in here is the only thing between the network and
# `wg set` on this node.
#
# Note what is NOT in this file: no DATABASE_URL, no JWT secrets. The agent's schema
# does not define them, so they are unreadable rather than merely unused — an exit
# node that is compromised gives up this node's interface and nothing else. Do not
# "simplify" the deploy by copying api.env here.

NODE_ENV=production

# A fresh secret per node, not shared with any other node:
#   openssl rand -base64 48
# The same value goes in this node's `agentToken` column, which is how the API
# authenticates to it. Rotate by updating both.
WG_AGENT_TOKEN=

# Loopback by default. Change this ONLY if the API reaches the agent over a private
# network; put TLS and a firewall in front of anything else. This machine is already
# publicly reachable on UDP 51820 — do not add a second public surface that can
# rewrite the peer list.
AGENT_BIND=127.0.0.1
AGENT_PORT=8787

# The interface this node's peers live on. Must match wg-quick@<iface>.
WG_INTERFACE=wg0
WG_BINARY=/usr/bin/wg
WG_QUICK_BINARY=/usr/bin/wg-quick
