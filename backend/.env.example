# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins. Leave empty in dev to allow all.
CORS_ORIGINS=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://aegis:aegis@localhost:5432/aegis?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
# These MUST differ from each other, and MUST be replaced in production.
JWT_ACCESS_SECRET=replace-me-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-me-a-DIFFERENT-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Max simultaneous devices per user. Enforced on POST /devices.
MAX_DEVICES_PER_USER=5

# ─── WireGuard ────────────────────────────────────────────────────────────────
# Interface the API manages.
WG_INTERFACE=wg0

# Peer-mutation driver:
#   exec  → real `wg` via execFile. Requires Linux + the sudoers rule (see docs/DEPLOY.md).
#   fake  → in-memory stub. Use this for local development on macOS/Windows,
#           where `wg` does not exist. NEVER set this in production.
WG_RUNNER=fake

# Absolute path to the `wg` binary. Only used when WG_RUNNER=exec.
WG_BINARY=/usr/bin/wg
WG_QUICK_BINARY=/usr/bin/wg-quick

# Reconcile wg0 against the database on application boot.
WG_RECONCILE_ON_BOOT=true

# ─── Seed values for the first node (used by prisma/seed.ts) ──────────────────
# The server's WireGuard PUBLIC key: cat /etc/wireguard/server.pub
SEED_NODE_NAME="Mumbai #1"
SEED_NODE_REGION=in-mumbai
SEED_NODE_PUBLIC_KEY=
SEED_NODE_ENDPOINT=vpn.example.com:51820
SEED_NODE_SUBNET_V4=10.7.0.0/24
SEED_NODE_DNS=10.7.0.1
SEED_NODE_MTU=1420

# ─── Reverse proxy ────────────────────────────────────────────────────────────
# Honour X-Forwarded-For when identifying the client IP for rate limiting.
#   Set to true  when a reverse proxy (Caddy) sits in front — the production case.
#   Set to false when the API is reached directly.
# Getting this wrong breaks rate limiting in one of two ways:
#   false behind a proxy -> all users share the proxy's IP and are throttled as one
#   true with no proxy   -> clients can forge X-Forwarded-For and bypass throttling
TRUST_PROXY=false
